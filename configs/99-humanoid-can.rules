# Humanoid Studio — persistent CAN interface naming
# CANable adapters (gs_usb driver) identified by USB serial number.
# Automatically configures bitrate 1 Mbps and brings interface up on plug-in.
#
# Install:
#   sudo cp /home/nse/humanoid-studio/configs/99-humanoid-can.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#
# VERIFY MAPPING before relying on this file:
#   can_left_leg  → serial 0032004A5043570120323339  (was can0)
#   can_right_leg → serial 0030002E5446571020343032  (was can1)
# To confirm: unplug one adapter and check which leg's joints stop responding.
# To find serial for new adapters: udevadm info /sys/class/net/<iface> --query=property | grep ID_SERIAL_SHORT

# ── Left leg ──────────────────────────────────────────────────────────────────
SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="0032004A5043570120323339", NAME="can_left_leg", RUN+="/bin/sh -c '/usr/bin/ip link set can_left_leg type can bitrate 1000000 && /usr/bin/ip link set can_left_leg up'"

# ── Right leg ─────────────────────────────────────────────────────────────────
SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="0030002E5446571020343032", NAME="can_right_leg", RUN+="/bin/sh -c '/usr/bin/ip link set can_right_leg type can bitrate 1000000 && /usr/bin/ip link set can_right_leg up'"

# ── Left arm (fill in serial when adapter is acquired) ───────────────────────
# SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="REPLACE_WITH_LEFT_ARM_SERIAL", NAME="can_left_arm", RUN+="/bin/sh -c '/usr/bin/ip link set can_left_arm type can bitrate 1000000 && /usr/bin/ip link set can_left_arm up'"

# ── Right arm (fill in serial when adapter is acquired) ──────────────────────
# SUBSYSTEM=="net", ACTION=="add", ATTRS{serial}=="REPLACE_WITH_RIGHT_ARM_SERIAL", NAME="can_right_arm", RUN+="/bin/sh -c '/usr/bin/ip link set can_right_arm type can bitrate 1000000 && /usr/bin/ip link set can_right_arm up'"
